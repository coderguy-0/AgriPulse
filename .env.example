# AGRIPULSE local environment example. Copy to .env; never commit real secrets.
# The unified server serves the frontend and same-origin /api on this address.
PORT=3000
HOST=0.0.0.0

# Set true only behind a trusted one-hop TLS proxy (for example Render).
TRUST_PROXY=false

# File-backed workspace database. Use a persistent, backed-up disk in deployment.
AGRIPULSE_DB_PATH=.data/agripulse.sqlite

# Demo credential access. Development defaults on; production defaults off.
# The login-page launchers additionally require VITE_DEMO_MODE=true at build time.
ALLOW_DEMO_SESSIONS=true
VITE_DEMO_MODE=true

# Seconds without a trusted heartbeat before a paired device is shown offline.
DEVICE_ONLINE_WINDOW_SECONDS=300

# Only for ADDITIONAL trusted browser origins, comma-separated. Same-origin requests
# are accepted automatically; do not use '*', and do not put localhost in production.
WEB_ORIGINS=

# Optional real weather integration (server-only credentials).
# Without both values, /api/weather reports unavailable instead of inventing weather.
WEATHER_PROVIDER=
WEATHER_API_KEY=
# Supported provider when configured: WEATHER_PROVIDER=weatherapi
