# Node 22.22+; copy values into the process environment (npm scripts use .env).
API_HOST=0.0.0.0
API_PORT=4000
AGRIPULSE_DB_PATH=.data/agripulse.sqlite
NODE_ENV=development
# Set false to disable shared demo sessions. Always disabled in production.
ALLOW_DEMO_SESSIONS=false
# Production: exact HTTPS public origin(s), comma separated. Never use *.
WEB_ORIGINS=https://agripulse.example.com
TRUST_PROXY=false
DEVICE_ONLINE_WINDOW_SECONDS=300
# Optional weather integration. Keys remain on the server; never use VITE_* secrets.
WEATHER_PROVIDER=weatherapi
WEATHER_API_KEY=
# Optional browser integrations, public same-origin URLs only. No keys.
VITE_NEWS_API_ENDPOINT=
VITE_AI_BACKEND_ENDPOINT=
