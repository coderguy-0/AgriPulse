# ==============================================================================
# AGRIPULSE Environment Variables Configuration
# ==============================================================================

# Server configuration
# Port and Host for the unified server (Render, Railway, Docker, etc.)
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=true

# Database storage path (defaults to .data/agripulse.sqlite if omitted)
AGRIPULSE_DB_PATH=.data/agripulse.sqlite

# Demo access control
# - In development: demo access is active by default.
# - In production: set ALLOW_DEMO_SESSIONS=true to allow demo session endpoints.
ALLOW_DEMO_SESSIONS=true

# Frontend Demo Mode (build-time / client variable)
# Set to 'false' only if you want to explicitly hide the demo accounts card in UI
VITE_DEMO_MODE=true

# Device and IoT telemetry window
# Number of seconds without heartbeat before a paired device is marked offline (default 300)
DEVICE_ONLINE_WINDOW_SECONDS=300

# Allowed CORS origins for external web clients calling the API (comma-separated)
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Weather Provider Configuration (Optional external provider integration)
# When omitted, the app fails closed safely without fabricating fake weather data.
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Optional external service endpoints
VITE_AI_BACKEND_ENDPOINT=
VITE_NEWS_API_ENDPOINT=