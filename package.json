{
  "name": "agripulse",
  "private": true,
  "version": "1.0.0",
  "description": "AGRIPULSE — intelligent farm digital twin and early crop-stress detection platform (farmer and seller portals)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit && node --check server/index.mjs && node --check server/app.mjs && node --check server/auth-service.mjs && node --check server/device-service.mjs && node --check server/security.mjs && node --check server/schemas.mjs && node --check server/workspace.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/test/*.test.mjs",
    "test:render": "node scripts/buildSmoke.mjs && node .smoke/ssrSmoke.cjs",
    "test:all": "npm test && npm run test:web && npm run test:render",
    "test:web": "node scripts/buildTests.mjs && node --test \".smoke/tests/*.test.cjs\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
